# Robin Agent Plus + Addon Environment Variables
# Copy to .env and fill EVERY value before first run. This file ships
# ONLY placeholders - no real addresses, keys, or tokens.
# New machine? Read FIRST_BOOT.md first - it is the ordered wiring checklist.

# Odoo CRM
ODOO_URL=https://your-odoo-instance.odoo.com
ODOO_DB=your_database_name
ODOO_USER=your@email.com
ODOO_PASSWORD=your_odoo_password

# Backoffice emails (App Passwords for Gmail, not real passwords).
# These are YOUR accounts - create fresh on each new device; they never travel.
BOSS_EMAIL=your-boss-backoffice@gmail.com
BOSS_APP_PASSWORD=your_boss_app_password
WILL_EMAIL=your-will-backoffice@gmail.com
WILL_APP_PASSWORD=your_will_app_password

# Google Workspace (if using OAuth instead of the custom google_api)
GOOGLE_CREDENTIALS_PATH=~/.hermes/google_credentials.json
